{
  "name": "@receipts/record-server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Off-chain Record Server for Receipts: World ID verification and EIP-712 review attestations.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "arkiv:publish": "tsx --env-file-if-exists=.env src/arkiv/cli.ts",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@hono/node-server": "2.1.6",
    "@worldcoin/idkit-core": "4.6.0",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.16",
    "pg": "8.23.1",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
