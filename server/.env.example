# Copy to `server/.env` and fill in. `.env` is gitignored; this template is committed.
# The `dev` and `start` scripts load it via Node's built-in --env-file-if-exists.
#
# Never commit real values. Everything below marked SECRET must come from a
# secrets manager in any non-local deployment.

# HTTP port. Optional, defaults to 3000.
PORT=3000

# One of: development | test | production. Optional, defaults to development.
NODE_ENV=development

# World Developer Portal app identifier. The frontend initializes IDKit with
# this. Public, but still not logged. Format: app_<identifier>
WORLD_APP_ID=

# World Developer Portal relying-party identifier. Carried in rp_context and
# used as the path segment of the v4 verification endpoint. Distinct from
# WORLD_APP_ID: World ID 4.0 scopes nullifiers to the RP, not the app, so
# changing this changes every nullifier. Format: rp_<identifier>
WORLD_RP_ID=

# World ID environment proofs must be produced in: production | staging |
# sandbox. Optional, defaults to production. A staging proof is cheap to obtain,
# so the proof endpoint rejects any proof whose environment differs from this.
WORLD_ENVIRONMENT=production

# SECRET. World Developer Portal RP signing key, used by signRequest() to sign
# the rp_context that IDKit requires in World ID 4.0. A 32-byte hex scalar (the
# 0x prefix is optional); signing is secp256k1 over an EIP-191 message. Never
# send this to a client and never log it.
#
# DEPLOYMENT PREREQUISITE — RP key registration. The authorized public key
# committed to the on-chain registry for WORLD_RP_ID must be the one derived
# from WORLD_SIGNING_KEY. World ID allows a single authorized key per RP at
# launch, so a mismatch invalidates every rp_context this server signs.
# Registering an RP is a one-time, paid, public action; the Developer Portal
# reports the current signer address and registration status.
#
# Actions are NOT pre-registered. World ID 4.0 derives the nullifier from
# (identity, rp_id, action) by hashing the action into a field element, so
# "review-agent-<agentId>" needs no Portal entry ahead of time, and the Portal
# creates the action record itself on first successful verification.
#
# UNVERIFIED — test against staging before relying on any of it: whether
# thousands of dynamic per-agent actions behave well at scale, how the Portal's
# max_verifications default applies to them, and environment scoping (an action
# exercised in staging does not thereby exist in production, which presents as
# a silently failing frontend rather than an error).
WORLD_SIGNING_KEY=

# SECRET. The Record Server's EOA private key. Its address must equal the
# ReviewGateway's immutable `recordServerSigner`, or every attestation is
# rejected on-chain. 0x-prefixed, 32 bytes (64 hex characters).
RECORD_SERVER_PRIVATE_KEY=

# Deployed ReviewGateway address. Becomes the EIP-712 domain's
# verifyingContract, so a wrong value produces attestations the gateway rejects.
REVIEW_GATEWAY_ADDRESS=

# Chain the ReviewGateway is deployed on; the EIP-712 domain's chainId.
# 11155111 = Ethereum Sepolia.
CHAIN_ID=11155111

# SECRET-ISH. JSON-RPC endpoint for CHAIN_ID. Read once at startup to confirm
# the chain really is CHAIN_ID and that the gateway's recordServerSigner()
# equals the address derived from RECORD_SERVER_PRIVATE_KEY; the server refuses
# to start if either disagrees. Provider URLs usually embed an API key, so this
# is redacted in logs and never included in an error message.
# Example: https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=

# Public base URL this server is reachable at. Required.
# The Record Server derives each review's signed `feedbackURI` as
# <REVIEW_CONTENT_BASE_URL>/reviews/<feedbackHash>, and serves the review text
# back at that path. It is part of the EIP-712 digest, so changing it changes
# every attestation signed afterwards; URIs already signed stay valid and must
# keep resolving.
# Must be a bare http(s) origin — no path, query string, fragment or
# credentials. Deploy behind a path prefix by stripping it in the proxy.
# Example: https://receipts.example
REVIEW_CONTENT_BASE_URL=

# SQLite file. Optional, defaults to ./data/receipts.db. The parent directory is
# created on boot. Use :memory: for a throwaway database.
DATABASE_PATH=./data/receipts.db

# ---------------------------------------------------------------------------
# Receipts reputation engine (optional as a group)
#
# Supply all three addresses to mount GET /api/agents/:agentId/reputation.
# Omit any of them and the endpoint is not mounted; the rest of the server is
# unaffected, so an existing deployment keeps working without these set.
# ---------------------------------------------------------------------------

RECEIPT_SETTLER_ADDRESS=0xC3AA7a2F43d83680f9E0B97e0Eb4fD01E421ceDe
IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713

# Block the ReviewGateway was deployed in. Log scans start here; leaving it at
# 0 works but makes every scan walk the whole chain.
GATEWAY_DEPLOY_BLOCK=12064002

# ---------------------------------------------------------------------------
# Database
#
# Explicit, never inferred. `sqlite` is the default for local development;
# production REFUSES TO BOOT on anything but `postgres`, because SQLite
# cannot enforce UNIQUE (agent_id, nullifier) across processes -- two tasks
# would mean two databases and one human could obtain two attestations.
# ---------------------------------------------------------------------------

DATABASE_DRIVER=sqlite

# Required when DATABASE_DRIVER=postgres. Secret: it carries the password,
# and it is redacted from the startup banner like every other secret.
# DATABASE_URL=postgres://receipts:PASSWORD@postgres:5432/receipts

# Used only by the sqlite driver.
DATABASE_PATH=./data/receipts.db

# ---------------------------------------------------------------------------
# Arkiv publisher (npm run arkiv:publish) -- NOT read by the API server
#
# A separate process mirrors confirmed reviews and reputation snapshots to
# Arkiv. It reuses the chain settings above and needs its own key, which must
# NOT be RECORD_SERVER_PRIVATE_KEY: the CLI refuses to run if the publisher
# address equals the gateway's recordServerSigner. See arkiv/schema.md.
# ---------------------------------------------------------------------------

# Secret. Signs Arkiv transactions. Needed only for --execute.
# ARKIV_PUBLISHER_PRIVATE_KEY=0x...

# Lets a dry run plan without the key.
# ARKIV_PUBLISHER_ADDRESS=0x...

# Optional. Empty uses the public, rate-limited Rabdi endpoint. Get one at
# https://hub.arkiv.network/access-keys
# ARKIV_ACCESS_KEY=

# Sepolia blocks a review must be buried under before it is published.
# ARKIV_CONFIRMATIONS=12

# Where to fetch review text; defaults to REVIEW_CONTENT_BASE_URL.
# ARKIV_CONTENT_BASE_URL=http://localhost:3000

# Secret (contains DB passwords). Comma-separated Postgres URLs holding World ID
# verification records, opened read-only to find which RP verified each review.
# Unset: every review is published as worldIdEnvironment=unknown.
# ARKIV_PROVENANCE_DATABASE_URLS=

# Which RP is which environment. An RP not listed resolves to unknown.
# ARKIV_RP_ENVIRONMENTS=rp_d3afb91156ea1942:production,rp_c357f900d4501523:staging
