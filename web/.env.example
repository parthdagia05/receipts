# Copy this file to `.env` and adjust. `.env` is gitignored.
#
# IMPORTANT: every `VITE_`-prefixed variable is inlined into the JavaScript
# bundle and is therefore PUBLIC. Never put a private key, a Record Server
# secret, or an RPC URL carrying an API key in one of them.

# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------

# Ethereum Sepolia.
VITE_CHAIN_ID=11155111

# JSON-RPC endpoint(s) used for browser reads (agents, reviews, balances).
# Comma-separate several to use the first that answers; the app appends its
# own public defaults behind whatever you list, so one bad endpoint cannot
# leave it with no chain.
#
# Each endpoint MUST send permissive CORS headers, which many public Sepolia
# nodes do not (rpc.sepolia.org, for one, sends none and fails in a browser).
#
# This value is public: it is inlined into the bundle. Use a key-free endpoint
# or one whose key is scoped to read-only, origin-restricted use. Never the
# private endpoint from the root `.env`.
#
# Note: ad-blocking extensions block many public RPC hosts, which looks
# identical to the endpoint being down. The fallback list exists partly for
# that case.
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com,https://1rpc.io/sepolia

# Deployed Receipts contracts (Ethereum Sepolia, verified on-chain).
VITE_REVIEW_GATEWAY_ADDRESS=0xC4052D50FAA61f43fadA76AEDE7dbf70381cA9BD
VITE_RECEIPT_SETTLER_ADDRESS=0xC3AA7a2F43d83680f9E0B97e0Eb4fD01E421ceDe
VITE_NULLIFIER_REGISTRY_ADDRESS=0xBA688eDFd43719378b8D3dC333C858e8d5720a4C

# ERC-8004 registries for this chain (all official testnets share this pair).
VITE_IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
VITE_REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713

# Block the ReviewGateway was deployed in. Review log scans start here rather
# than at genesis, which would be both slow and pointless.
VITE_GATEWAY_DEPLOY_BLOCK=12064002

# Block explorer used for transaction and address links.
VITE_EXPLORER_URL=https://sepolia.etherscan.io

# ---------------------------------------------------------------------------
# Record Server
# ---------------------------------------------------------------------------

# Base URL for the Record Server API. Leave EMPTY to use the current origin,
# which is what the dev proxy (below) and a single-host deployment both want.
# Set it only when the API is served from a genuinely different origin — in
# which case that server needs CORS configured for this app's origin.
VITE_API_BASE_URL=

# Dev-server proxy target. Not `VITE_`-prefixed, so it never reaches the
# bundle; it is read by vite.config.ts at build/serve time only.
RECORD_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Arkiv (public record panel on the agent page)
# ---------------------------------------------------------------------------

# The Receipts Arkiv publisher. The panel only shows entities whose $creator
# is this address; anyone can write under the schema tags. Empty hides the
# panel's data and says Arkiv is not configured. Public.
VITE_ARKIV_PUBLISHER_ADDRESS=

# Optional, public. An access key locked to this app's origin raises the read
# rate limit; reads work without one.
VITE_ARKIV_ACCESS_KEY=
