# Copy to `.env.prod` on the instance and fill in. `.env.prod` is gitignored
# by the `.env.*` rule; this template is committed.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# Compose needs it on EVERY command, not just `up`:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod ps
#
# Omitting the flag makes compose fall back to `.env`, and the `:?` variables
# below then abort the command. That is deliberate — a stack that started with
# half its configuration missing would be worse.
#
# This file is never copied into the image. The server reads its configuration
# from the environment compose provides; `server/.dockerignore` excludes
# `.env*` from the build context.

# --- image -----------------------------------------------------------------
#
# The API image is ${ECR_REGISTRY}/receipts-api:${IMAGE_TAG}. Both are
# REQUIRED -- compose refuses to start without them. That is deliberate: a
# default tag is how a deployment silently serves the wrong build.

# <account-id>.dkr.ecr.<region>.amazonaws.com in production. Written by
# user-data from the Terraform outputs. Use `local` for a local build.
ECR_REGISTRY=

# The 7-character commit SHA CI pushed. `latest` is REJECTED by Terraform,
# by user-data and by the deploy script: ECR tags are immutable, so `latest`
# is never published and a rollback could not name a specific build.
# Use `dev` for a local build.
IMAGE_TAG=

# --- database --------------------------------------------------------------

# DATABASE_URL is NOT set here. docker-compose.prod.yml composes it from the
# three variables below, so the password lives in exactly one place.
POSTGRES_DB=receipts
POSTGRES_USER=receipts

# Required. Generate a fresh one, e.g. `openssl rand -base64 32`.
# Changing it after the first `up` does NOT change the database's password:
# POSTGRES_PASSWORD only applies when initdb creates the data directory, so
# afterwards the API would simply fail to authenticate. Rotate with ALTER USER.
POSTGRES_PASSWORD=

# --- secrets ---------------------------------------------------------------
# Compose aborts if any of these is empty, rather than starting a server that
# would fail on its first request.

# The key whose address the deployed ReviewGateway accepts as the attestation
# signer. The server verifies this against the chain at startup and refuses to
# boot on a mismatch.
RECORD_SERVER_PRIVATE_KEY=

# Signs the World ID rp_context.
WORLD_SIGNING_KEY=

RPC_URL=

# --- chain -----------------------------------------------------------------

CHAIN_ID=11155111
REVIEW_GATEWAY_ADDRESS=
RECEIPT_SETTLER_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=

# The block the gateway was deployed at, so log queries start there instead of
# walking the chain from genesis.
GATEWAY_DEPLOY_BLOCK=0

# Blocks to stay behind the head when pinning a reputation snapshot.
# Optional; defaults to 2, which is what user-data leaves in effect.
#
# Zero reads at the chain head and races load-balanced public RPC pools: the
# head comes from one node and the log query lands on another a block behind,
# which failed roughly five reputation requests in six. With a dedicated RPC
# endpoint this can go back to 0 for maximum freshness.
# REPUTATION_CONFIRMATIONS=2

# --- World ID --------------------------------------------------------------

WORLD_APP_ID=
WORLD_RP_ID=

# Must match the environment this app is configured for in the World Developer
# Portal. A staging app with `production` here fails verification.
WORLD_ENVIRONMENT=production

# --- HTTP ------------------------------------------------------------------

# Where the attestation's feedbackURI points, so it must be the public origin
# this stack serves on — not localhost.
REVIEW_CONTENT_BASE_URL=

# Comma-separated. Required: the code defaults to allowing nothing.
CORS_ALLOWED_ORIGINS=

# Makes the rate limiter read X-Forwarded-For. Correct only because Caddy is
# the single hop in front of the API; with the API published directly, a client
# could forge the header and every bucket would be attacker-chosen.
TRUST_PROXY=true

# --- Caddy -----------------------------------------------------------------

# The site address. A bare hostname makes Caddy request a Let's Encrypt
# certificate automatically, so set it only once DNS resolves to this instance
# — a failed challenge counts against the rate limit.
#
#   api.example.com   -> HTTPS with an automatic certificate
#   :80               -> plain HTTP, for local validation
CADDY_SITE_ADDRESS=:80

# Where Let's Encrypt sends expiry warnings. Unused while the address is `:80`.
CADDY_ACME_EMAIL=
