# Copy this file to `.env` and fill in your values.
# `.env` is gitignored; `.env.example` is committed as a template.
# forge automatically loads `.env` from the project root before running.

# Set to true to run the Mainnet and Sepolia fork integration tests.
# Leave false for the default offline Foundry test suite: the fork tests report
# as skipped, no RPC variable below is read, and the run needs no network.
RUN_FORK_TESTS=false

# Ethereum Mainnet RPC endpoint used by the AttackLab fork test.
# MUST be an ARCHIVE node: the test forks at block 26330000, whose state
# full (non-archive) nodes no longer serve.
# Known-working free option: https://eth.drpc.org  (an Alchemy/Infura key also works)
MAINNET_RPC_URL=

# Ethereum Sepolia RPC endpoint used by the ReceiptSettler fork integration tests
# (test/ReceiptSettlerFork.t.sol).
# MUST be an ARCHIVE node, for the same reason as Mainnet: these tests now fork at
# the pinned SEPOLIA_FORK_BLOCK rather than at latest. Ordinary public endpoints
# prune state after roughly 128 blocks (~25 minutes) and answer anything older
# with "historical state is not available".
# Supply your own archive-capable Sepolia endpoint. Check it can serve the block
# below before running: an endpoint that answers at latest may still refuse to
# serve state that old.
SEPOLIA_RPC_URL=

# Required when RUN_FORK_TESTS=true.
# Pins the Sepolia fork to one block, so the tests are reproducible. setUp() runs
# again before every test, so forking at latest let each test resolve a different
# head block and read whatever live state happened to exist at the time.
# 12000000 is verified: Circle USDC and the ERC-8004 Identity Registry both carry
# code there, USDC's RECEIVE_WITH_AUTHORIZATION_TYPEHASH matches the constant the
# tests assert, and all seven fork tests pass against it.
SEPOLIA_FORK_BLOCK=12000000

# ---------------------------------------------------------------------------
# Deployment (script/Deploy.s.sol). forge loads this file, so these live here
# rather than in server/.env.example.
#
# No defaults, deliberately: a Mainnet address silently reused on a testnet is
# exactly the mistake these would hide, and the gateway's registry addresses are
# immutable once deployed. The script requires every one of them.
#
# The broadcasting key is NOT read from here. Pass it on the command line:
#   forge script script/Deploy.s.sol:Deploy --rpc-url "$RPC_URL" --broadcast --account <keystore>
# ---------------------------------------------------------------------------

# The address the Record Server signs attestations with — the address
# RECORD_SERVER_PRIVATE_KEY (server/.env) derives. A mismatch makes every
# attestation unverifiable on-chain and cannot be corrected without deploying a
# replacement gateway.
RECORD_SERVER_SIGNER=

# Circle USDC for the target chain.
# Ethereum Sepolia: 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Base Sepolia:     0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=

# ERC-8004 registries for the target chain. All official testnets share one
# pair, and all mainnets share another — so the testnet values below are wrong
# on mainnet and vice versa.
#
# Testnets (incl. Ethereum Sepolia, chain 11155111):
#   IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
#   REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
# Mainnets:
#   IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
#   REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
IDENTITY_REGISTRY=
REPUTATION_REGISTRY=

# Minimum USDC a receipt must carry for a paid review, in 6-decimal units.
# 1000000 = 1 USDC. Immutable on both the settler and the gateway.
MIN_PAYMENT=1000000
