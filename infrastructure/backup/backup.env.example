# Environment for receipts-backup.service.
#
#   sudo install -m 600 backup.env.example /opt/receipts/backup.env
#
# Every line here is non-secret: paths, a bucket name, retention counts. The
# database password is deliberately absent -- `pg_dump` runs inside the
# postgres container over its local socket and never needs one. If you find
# yourself adding a password here, something has gone wrong upstream.

# Where the stack lives on the instance.
COMPOSE_FILE=/opt/receipts/docker-compose.prod.yml
ENV_FILE=/opt/receipts/.env.prod
PG_SERVICE=postgres

# Must match POSTGRES_USER / POSTGRES_DB in .env.prod.
POSTGRES_USER=receipts
POSTGRES_DB=receipts

BACKUP_DIR=/opt/receipts/backups

# Leave empty until the bucket exists. The script still runs and still keeps
# a verified local copy, but it logs a warning and the backup protects
# against nothing that also destroys the instance.
S3_BUCKET=
S3_PREFIX=postgres

# Local retention only. Objects in S3 expire via the bucket lifecycle rule;
# the instance has no permission to delete them.
RETENTION_DAYS=7

# The newest N are kept whatever their age, so a long outage cannot age out
# the last good backup.
RETENTION_MIN_KEEP=3
